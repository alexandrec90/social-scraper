# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every key here with a safe placeholder value.

# ---------------------------------------------------------------------------
# Worktree identity and host ports
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. It namespaces
# the stack's containers, network, and volumes, so a worktree running in parallel
# stays fully independent — and `scripts/docker_common.py`-style tooling filters
# `docker ps` by it.
COMPOSE_PROJECT_NAME=social-scraper

# Every published port is `conventional_base + slot`, where this checkout's slot
# is 2. The registry that assigns slots is devkit's `ports.toml` — add a
# project there rather than picking a free-looking number by hand. Re-generate
# this block with: python <devkit>/scripts/devkit_ports.py social-scraper
DB_HOST_PORT=5434

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The host-side URL. It must agree with DB_HOST_PORT above — that is the pairing
# that breaks first when a worktree's ports are edited by hand.
DATABASE_URL=postgresql+psycopg://social_scraper:social_scraper_local_dev@127.0.0.1:5434/social_scraper
POSTGRES_USER=social_scraper
POSTGRES_PASSWORD=social_scraper_local_dev
POSTGRES_DB=social_scraper

# ---------------------------------------------------------------------------
# Data lake (bronze tier)
# ---------------------------------------------------------------------------
# Hive-partitioned Parquet plus `_catalog/<dataset>.json`, written by `export`.
# The bucket is PRIVATE, always — see .claude/rules/data-lake.md for what may and
# may not be written to it.
#
# ARCHIVE_ROOT is the local tree, always written: the staging buffer, and what
# `social-scraper lake` reads. Relative paths resolve against the directory you run
# the scraper from -- this value is right for the main checkout
# (`vs-code/social-scraper`), not for a nested worktree.
ARCHIVE_ROOT=../data-lake/data/archive
#
# ibkr_trader does NOT read ARCHIVE_ROOT: it reads the Cloudflare R2 bucket
# `data-lake` from inside its container, through data-lake's `load_catalog`. To
# reach it, set ARCHIVE_BACKEND=s3 and copy ibkr_trader's ARCHIVE_S3_* block here
# unchanged -- the names and meanings are data-lake's `ArchiveSettings`. Every
# exported partition and catalog then lands in the bucket too, at the same keys
# relative to ARCHIVE_ROOT (under ARCHIVE_S3_PREFIX if set). Unset or "local" keeps
# the export local-only. After switching it on, run `social-scraper export --full`
# once so the bucket gets the history the local tree already has.
ARCHIVE_BACKEND=local
ARCHIVE_S3_BUCKET=
# https://<account-id>.r2.cloudflarestorage.com for R2; empty means AWS S3.
ARCHIVE_S3_ENDPOINT_URL=
# R2 wants "auto".
ARCHIVE_S3_REGION=auto
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
# Key prefix inside the bucket. Empty, as in ibkr_trader: `_catalog/` at the root.
ARCHIVE_S3_PREFIX=

# ---------------------------------------------------------------------------
# Scraper -- browser
# ---------------------------------------------------------------------------
# Browser profiles (one per platform) and the cached symbol directory live here.
DATA_DIR=./data
LOGS_DIR=./logs
# "chrome" drives your installed Google Chrome; empty uses Playwright's Chromium
# (then run `playwright install chromium` once).
BROWSER_CHANNEL=chrome
# true opens no window: Chrome's new headless, with the `HeadlessChrome` user-agent token
# renamed, gets through Reddit and X (measured 2026-10-02; the unrenamed token is blocked
# by both). `login` is always visible; `scrape --headed` shows the window for one run.
BROWSER_HEADLESS=true
# With BROWSER_HEADLESS=false, start Chrome off-screen and minimized so a cycle never
# steals the keyboard focus. Ignored headless; `login` and `--headed` always show it.
BROWSER_MINIMIZED=true
# Zone for X_ACTIVE_HOURS and REDDIT_ACTIVE_HOURS.
SCRAPER_TIMEZONE=America/Toronto
# Minutes between cycles of `social-scraper run` (+/- 20% jitter).
CYCLE_MINUTES=30

# ---------------------------------------------------------------------------
# Scraper -- symbols
# ---------------------------------------------------------------------------
# One-symbol-per-line files merged into the NASDAQ directory, e.g. ibkr_trader's list
# for TSX names the US directory lacks.
SYMBOL_EXTRA_FILES=../ibkr_trader/tickers.txt
# Always read first, whatever is trending: X and Bluesky searches, StockTwits streams,
# TradingView ideas. Comma-separated.
WATCHLIST=

# ---------------------------------------------------------------------------
# Scraper -- Reddit (anonymous is fine; `uv run social-scraper login reddit` is optional)
# ---------------------------------------------------------------------------
REDDIT_SUBREDDITS=wallstreetbets,stocks,investing,options,StockMarket,pennystocks,Daytrading,ValueInvesting,smallstreetbets,thetagang,CanadianInvestor
REDDIT_IGNORE_AUTHORS=AutoModerator,VisualMod
# Paced for a machine that stays on: budgets are the ceiling, the delay is the pace.
REDDIT_MIN_DELAY_S=15
REDDIT_MAX_DELAY_S=40
REDDIT_HOURLY_BUDGET=90
REDDIT_DAILY_BUDGET=1000
# Local hours Reddit may be read (06:00-23:59). Empty means around the clock.
REDDIT_ACTIVE_HOURS=6-24
REDDIT_MAX_PAGES=3
REDDIT_REFRESH_HOURS=6

# ---------------------------------------------------------------------------
# Scraper -- X (search needs `uv run social-scraper login x`; timelines work logged out)
# ---------------------------------------------------------------------------
# X is the platform that bans. Keep X_PAGES_PER_CYCLE x (60 / CYCLE_MINUTES) x active
# hours at or under X_DAILY_BUDGET, or the budget runs dry mid-day.
X_MIN_DELAY_S=60
X_MAX_DELAY_S=180
X_HOURLY_BUDGET=8
X_DAILY_BUDGET=90
X_PAGES_PER_CYCLE=3
X_SCROLLS_PER_PAGE=3
X_ACTIVE_HOURS=8-23
# Accounts always followed (and never dropped). The only discovery source when logged out.
X_SEED_ACCOUNTS=
X_MAX_TRACKED_ACCOUNTS=150
X_MIN_FOLLOWERS=500
X_SEARCH_SHARE=0.4
# Semicolon-separated generic discovery searches; the defaults live in config.py.
# X_DISCOVERY_QUERIES=

# ---------------------------------------------------------------------------
# Scraper -- the other platforms (README, "Platforms")
# ---------------------------------------------------------------------------
# What `scrape all` / `run` crawl, comma-separated. HFBoards is sports-only, so with
# DOMAINS=stocks it reports a skip; Polymarket reads each enabled domain's tags.
SCRAPE_PLATFORMS=reddit,x,stocktwits,tradingview,hfboards,bluesky,polymarket
# Platforms crawled at once, each in its own thread and browser (Chrome each, so mind
# the memory). 1 runs them one after another, which no longer fits a 30-minute cycle.
CRAWL_WORKERS=3
#
# Each platform has its own throttle, named like Reddit's and X's:
# <PLATFORM>_MIN_DELAY_S / _MAX_DELAY_S / _HOURLY_BUDGET / _DAILY_BUDGET / _ACTIVE_HOURS.
# Defaults (config.py) spend about half of each budget. None of these needs an account.
#
# StockTwits: one symbol stream (its 30 newest messages, with the author's Bullish or
# Bearish label) per load, through the browser; its trending list every few hours.
STOCKTWITS_SYMBOLS_PER_CYCLE=6
STOCKTWITS_TRENDING_HOURS=3
STOCKTWITS_ACTIVE_HOURS=6-24
# TradingView: one symbol's newest ideas (each Long, Short or neither) per load.
TRADINGVIEW_SYMBOLS_PER_CYCLE=3
TRADINGVIEW_ACTIVE_HOURS=7-23
# HFBoards (sports): forums come from the leagues' `hfboards_forums`; per forum, the
# thread list and then the newest page of up to this many threads with new posts.
HFBOARDS_FORUMS_PER_CYCLE=2
HFBOARDS_THREADS_PER_FORUM=3
HFBOARDS_ACTIVE_HOURS=7-24
# Bluesky: searchPosts on the public AppView, no account and no key. Stock searches are
# $TICKER (watchlist, then trending); sports ones are trending teams/athletes and the
# leagues' `bluesky_queries`.
BLUESKY_SEARCHES_PER_CYCLE=6
BLUESKY_SPORTS_SEARCHES_PER_CYCLE=3
# Polymarket: Gamma API, no account and no key. Stock tags here; sports tags come from
# the leagues' `polymarket_tags`. Overdue markets are re-read by id until they resolve.
POLYMARKET_STOCK_TAGS=stocks,earnings,equities,ipos,fed,economy
# Tags read a cycle, longest unread first (0 = all): a page of NFL markets is tens of MB.
POLYMARKET_TAGS_PER_CYCLE=12
POLYMARKET_PAGES_PER_TAG=1
# Only markets that traded more than this (USD) in the last day are stored; most never do.
POLYMARKET_MIN_VOLUME_24H=0
POLYMARKET_RESOLVE_PER_CYCLE=40

# ---------------------------------------------------------------------------
# Scraper -- domains
# ---------------------------------------------------------------------------
# What a cycle collects: stocks, sports, or both. Both draw on the Reddit and X budgets
# above, which are sized for stocks alone -- raise them when adding sports.
DOMAINS=stocks

# ---------------------------------------------------------------------------
# Scraper -- sports (social_scraper/sports/; see README, "The sports domain")
# ---------------------------------------------------------------------------
# The hand-kept league list. `scripts/check-leagues.py` checks it against Mise-o-jeu+.
SPORTS_LEAGUES_FILE=sports-leagues.toml
# Each league is re-read from Wikidata once older than this, two leagues a cycle at most.
SPORTS_REFRESH_HOURS=168
SPORTS_SYNC_LEAGUES_PER_CYCLE=2
SPORTS_PLAYERS_PER_TEAM=6
# Subreddits a cycle visits (league ones and teams', by priority), one page per listing.
SPORTS_REDDIT_SUBS_PER_CYCLE=4
SPORTS_REDDIT_MAX_PAGES=1
SPORTS_X_PAGES_PER_CYCLE=2
# Accounts always followed for sports, besides the leagues' own (from Wikidata).
SPORTS_X_SEED_ACCOUNTS=
SPORTS_X_MAX_TRACKED_ACCOUNTS=150
SPORTS_X_MIN_FOLLOWERS=1000
# Wikidata lookups a cycle spends confirming names that keep coming up.
SPORTS_LOOKUPS_PER_CYCLE=5

# ---------------------------------------------------------------------------
# Scraper -- circuit breaker (shared)
# ---------------------------------------------------------------------------
BACKOFF_BASE_MINUTES=30
BACKOFF_MAX_MINUTES=720
# A captcha or account lock pauses the platform this long; each consecutive one doubles
# it, up to BLOCK_COOLDOWN_MAX_HOURS.
BLOCK_COOLDOWN_HOURS=24
BLOCK_COOLDOWN_MAX_HOURS=96

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=social-scraper
OTEL_RESOURCE_ATTRIBUTES=service.name=social-scraper,service.instance.id=social-scraper,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
