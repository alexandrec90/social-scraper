# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every key here with a safe placeholder value.

# ---------------------------------------------------------------------------
# Worktree identity and host ports
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. It namespaces
# the stack's containers, network, and volumes, so a worktree running in parallel
# stays fully independent — and `scripts/docker_common.py`-style tooling filters
# `docker ps` by it.
COMPOSE_PROJECT_NAME=social-scraper

# Every published port is `conventional_base + slot`, where this checkout's slot
# is 2. The registry that assigns slots is devkit's `ports.toml` — add a
# project there rather than picking a free-looking number by hand. Re-generate
# this block with: python <devkit>/scripts/devkit_ports.py social-scraper
DB_HOST_PORT=5434

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The host-side URL. It must agree with DB_HOST_PORT above — that is the pairing
# that breaks first when a worktree's ports are edited by hand.
DATABASE_URL=postgresql+psycopg://social_scraper:social_scraper_local_dev@127.0.0.1:5434/social_scraper
POSTGRES_USER=social_scraper
POSTGRES_PASSWORD=social_scraper_local_dev
POSTGRES_DB=social_scraper

# ---------------------------------------------------------------------------
# Data lake (bronze tier)
# ---------------------------------------------------------------------------
# S3-compatible object storage holding immutable Hive-partitioned Parquet, read
# through a DuckDB lens. The bucket is PRIVATE, always — see
# .claude/rules/data-lake.md for what may and may not be written to it.
# Leave these unset to keep the archive local-only (ARCHIVE_ROOT).
#
# ARCHIVE_ROOT is the POOLED data-lake tree: data-lake's `load_catalog` reads every
# producer's `_catalog/` from there (sports_betting and ibkr_trader point at it too).
# Relative paths resolve against the directory you run the scraper from -- this value
# is right for the main checkout (`vs-code/social-scraper`), not for a nested worktree.
ARCHIVE_ROOT=../data-lake/data/archive
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Scraper -- browser
# ---------------------------------------------------------------------------
# Browser profiles (one per platform) and the cached symbol directory live here.
DATA_DIR=./data
LOGS_DIR=./logs
# "chrome" drives your installed Google Chrome; empty uses Playwright's Chromium
# (then run `playwright install chromium` once).
BROWSER_CHANNEL=chrome
# Keep false: Reddit blocks headless Chrome outright (measured), and X is stricter still.
BROWSER_HEADLESS=false
# Start Chrome off-screen and minimized so a cycle never steals the keyboard focus.
# The `login` window is always shown regardless.
BROWSER_MINIMIZED=true
# Zone for X_ACTIVE_HOURS and REDDIT_ACTIVE_HOURS.
SCRAPER_TIMEZONE=America/Toronto
# Minutes between cycles of `social-scraper run` (+/- 20% jitter).
CYCLE_MINUTES=30

# ---------------------------------------------------------------------------
# Scraper -- symbols
# ---------------------------------------------------------------------------
# One-symbol-per-line files merged into the NASDAQ directory, e.g. ibkr_trader's list
# for TSX names the US directory lacks.
SYMBOL_EXTRA_FILES=../ibkr_trader/tickers.txt
# Always searched on X, whatever is trending. Comma-separated.
WATCHLIST=

# ---------------------------------------------------------------------------
# Scraper -- Reddit (anonymous is fine; `uv run social-scraper login reddit` is optional)
# ---------------------------------------------------------------------------
REDDIT_SUBREDDITS=wallstreetbets,stocks,investing,options,StockMarket,pennystocks,Daytrading,ValueInvesting,smallstreetbets,thetagang,CanadianInvestor
REDDIT_IGNORE_AUTHORS=AutoModerator,VisualMod
# Paced for a machine that stays on: budgets are the ceiling, the delay is the pace.
REDDIT_MIN_DELAY_S=15
REDDIT_MAX_DELAY_S=40
REDDIT_HOURLY_BUDGET=90
REDDIT_DAILY_BUDGET=1000
# Local hours Reddit may be read (06:00-23:59). Empty means around the clock.
REDDIT_ACTIVE_HOURS=6-24
REDDIT_MAX_PAGES=3
REDDIT_REFRESH_HOURS=6

# ---------------------------------------------------------------------------
# Scraper -- X (search needs `uv run social-scraper login x`; timelines work logged out)
# ---------------------------------------------------------------------------
# X is the platform that bans. Keep X_PAGES_PER_CYCLE x (60 / CYCLE_MINUTES) x active
# hours at or under X_DAILY_BUDGET, or the budget runs dry mid-day.
X_MIN_DELAY_S=60
X_MAX_DELAY_S=180
X_HOURLY_BUDGET=8
X_DAILY_BUDGET=90
X_PAGES_PER_CYCLE=3
X_SCROLLS_PER_PAGE=3
X_ACTIVE_HOURS=8-23
# Accounts always followed (and never dropped). The only discovery source when logged out.
X_SEED_ACCOUNTS=
X_MAX_TRACKED_ACCOUNTS=150
X_MIN_FOLLOWERS=500
X_SEARCH_SHARE=0.4
# Semicolon-separated generic discovery searches; the defaults live in config.py.
# X_DISCOVERY_QUERIES=

# ---------------------------------------------------------------------------
# Scraper -- circuit breaker (shared)
# ---------------------------------------------------------------------------
BACKOFF_BASE_MINUTES=30
BACKOFF_MAX_MINUTES=720
# A captcha or account lock pauses the platform this long; each consecutive one doubles
# it, up to BLOCK_COOLDOWN_MAX_HOURS.
BLOCK_COOLDOWN_HOURS=24
BLOCK_COOLDOWN_MAX_HOURS=96

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=social-scraper
OTEL_RESOURCE_ATTRIBUTES=service.name=social-scraper,service.instance.id=social-scraper,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
